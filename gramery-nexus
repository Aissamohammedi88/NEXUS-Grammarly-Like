async function lancerCorrection(texte){

  var id = ++derniereRequeteId;

  document.getElementById('stats-txt').innerHTML =

    '<span class="loader"></span>Analyse en cours...';



  var langue = document.getElementById('langue') ? document.getElementById('langue').value : 'fr';

  var r = await api_post('/api/corriger', {

    texte: texte,

    langue: langue,

    auto: true

  });



  // Anti-rebond : si une reponse plus recente est arrivee, on jette celle-ci

  if (id !== derniereRequeteId) return;



  if (!r.ok){

    document.getElementById('stats-txt').innerHTML =

      '<span class="pill r">ERREUR</span> ' + esc(r.err || '?');

    return;

  }



  document.getElementById('stats-txt').innerHTML =

    '<span class="pill g">' + r.nb_corrections + ' erreurs</span>' +

    '<span class="pill">' + esc(r.backend || '?') + '</span>' +

    (r.temps_ms ? '<span class="pill y">' + r.temps_ms + ' ms</span>' : '') +

    '<span class="pill p">auto</span>';



  document.getElementById('nb-err').textContent = r.nb_corrections;



  var el = document.getElementById('erreurs');

  if (r.nb_corrections === 0){

    el.innerHTML = '<div class="empty">Aucune erreur detectee.</div>';

  } else {

    el.innerHTML = r.corrections.map(function(c, i){

      var mot = c.mot ? '<b>' + esc(c.mot) + '</b>' : '<b>#' + (i+1) + '</b>';

      var cat = c.categorie ? '<span class="cat">' + esc(c.categorie) + '</span>' : '';

      var sugg = (c.suggestions && c.suggestions.length)

        ? '<div class="sugg">=> ' + c.suggestions.map(esc).join(' | ') + '</div>'

        : '';

      return '<div class="erreur">' + mot + cat +

