def http_post(url, data_bytes=None, headers=None, timeout=20):

    h = {

        "User-Agent": UA,

        "Accept": "application/json",

        "Accept-Encoding": "gzip",

    }

    if headers:

        h.update(headers)

    try:

        req = urllib.request.Request(url, data=data_bytes, headers=h, method="POST")

        t0 = time.time()

        with urllib.request.urlopen(req, timeout=timeout, context=CTX) as r:

            raw = r.read(2_000_000)

            if "gzip" in (r.headers.get("Content-Encoding", "") or "").lower():

                try:

                    raw = gzip.decompress(raw)

                except Exception:

                    pass

            return {

                "ok": True, "status": r.status,

                "body": raw.decode("utf-8", "ignore"),

                "ms": round((time.time() - t0) * 1000),

            }

    except urllib.error.HTTPError as e:

        try:

            body = e.read(500_000).decode("utf-8", "ignore")

        except Exception:

            body = ""

        return {"ok": False, "status": e.code, "body": body,

                "err": "HTTP " + str(e.code)}

    except Exception as e:

        return {"ok": False, "status": 0, "body": "", "err": str(e)[:150]}





