# LANGUAGE TOOL — correction

# ═══════════════════════════════════════════════════════════════════════════



def lt_ping():

    """Petit ping pour le statut vivant."""

    payload = urllib.parse.urlencode({"text": "test", "language": "en-US"}).encode()

    r = http_post(CONFIG["languagetool_url"], payload,

                  headers={"Content-Type": "application/x-www-form-urlencoded"},

                  timeout=8)

    with ETAT_LOCK:

        ETAT["dernier_ping"] = time.time()

        ETAT["lt_ok"] = bool(r.get("ok"))

        ETAT["lt_ms"] = r.get("ms", 0)

        ETAT["lt_endpoint"] = CONFIG["languagetool_url"]

    return r.get("ok", False)





def corriger_languagetool(texte, langue="fr"):

    payload = urllib.parse.urlencode({

        "text": texte,

        "language": langue,

    }).encode("utf-8")



    r = http_post(CONFIG["languagetool_url"], payload,

                  headers={"Content-Type": "application/x-www-form-urlencoded"})



    if not r.get("ok"):

        with ETAT_LOCK:

            ETAT["erreurs_total"] += 1

            ETAT["derniere_raison"] = r.get("err", "?")[:100]

        return {"ok": False, "err": r.get("err", "?"),

                "backend": "languagetool", "temps_ms": r.get("ms", 0)}



    try:

        data = json.loads(r["body"])

    except Exception as e:

        return {"ok": False, "err": "parse : " + str(e)[:150],

                "backend": "languagetool"}



    matches = data.get("matches", [])

    corrections = []

    for m in matches:

        reps = m.get("replacements", [])

        suggestions = [x.get("value", "") for x in reps][:6]

        offset = m.get("offset", 0)

        length = m.get("length", 0)

        mot = ""

        try:

            mot = texte[offset:offset + length]

        except Exception:

            pass

        corrections.append({

            "point": (m.get("rule") or {}).get("id", "?"),

            "titre": m.get("message", ""),

            "explication": (m.get("rule") or {}).get("description", "")[:200],

            "mot": mot,

            "offset": offset,

            "longueur": length,

            "suggestions": suggestions,

            "categorie": ((m.get("rule") or {}).get("category") or {}).get("name", "?"),

        })



    # Texte corrigé (1ere suggestion partout)

    texte_corrige = texte

    ops = [(c["offset"], c["longueur"], c["suggestions"][0])

           for c in corrections if c.get("suggestions")]

    ops.sort(key=lambda x: x[0], reverse=True)

    for off, ln, remp in ops:

        try:

            texte_corrige = texte_corrige[:off] + remp + texte_corrige[off + ln:]

        except Exception:

            continue



    with ETAT_LOCK:

        ETAT["derniere_correction"] = time.time()

        ETAT["dernier_nb"] = len(corrections)

        ETAT["derniere_langue"] = langue

        ETAT["corrections_total"] += 1

        ETAT["dernier_texte"] = texte[:200]

        ETAT["derniere_raison"] = "ok"



    return {

        "ok": True,

        "backend": "languagetool",

        "endpoint": CONFIG["languagetool_url"],

        "texte_original": texte,

        "texte_corrige": texte_corrige,

        "nb_corrections": len(corrections),

        "corrections": corrections,

        "temps_ms": r.get("ms", 0),

    }





