def port_libre(host, port):

    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

    try:

        s.settimeout(1)

        s.bind((host, port))

        return True

    except OSError:

        return False

    finally:

        try:

            s.close()

        except Exception:

            pass





def trouver_port(host, start, max_tries=30):

    for p in range(start, start + max_tries):

        if port_libre(host, p):

            return p

    return None





