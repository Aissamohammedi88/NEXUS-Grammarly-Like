def _c(code):

    if os.environ.get("NO_COLOR"):

        return ""

    if not sys.stdout.isatty():

        return ""

    return code





G = _c("\033[0;32m")   # vert

Y = _c("\033[1;33m")   # jaune

R = _c("\033[0;31m")   # rouge

B = _c("\033[0;36m")   # cyan

D = _c("\033[0;90m")   # gris

N = _c("\033[0m")      # reset





def log(msg, couleur=""):

    ts = time.strftime("%H:%M:%S")

    ligne = "[{}] {}{}{}".format(ts, couleur, msg, N if couleur else "")

    try:

        print(ligne, flush=True)

    except Exception:

        pass

    with LOG_LOCK:

        try:

            with open(LOG_FILE, "a", encoding="utf-8") as f:

                f.write("[{}] {}\n".format(

                    time.strftime("%Y-%m-%d %H:%M:%S"), msg))

        except OSError:

            pass





def log_correction(texte, corrections):

    """Affiche joliment une correction dans le terminal."""

    if not CONFIG.get("afficher_terminal", True):

        return

    n = len(corrections)

    if n == 0:

        log("OK  aucune erreur  « " + texte[:60] + " »", G)

        return

    log("{} correction(s) sur {} caractere(s)".format(n, len(texte)), Y)

    for i, c in enumerate(corrections[:12], 1):

        mot = c.get("mot", "")

        titre = c.get("titre", "")

        sugg = c.get("suggestions", [])

        s = (" -> " + " | ".join(sugg[:3])) if sugg else ""

        log("  #{} {}{}{} {}{}{}".format(

            i, R, mot, N, D + titre[:80], s, N), "")

    if n > 12:

        log("  ... et {} autres".format(n - 12), D)





