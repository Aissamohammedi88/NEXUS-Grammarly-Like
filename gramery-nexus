                    historique_add({

                        "texte": texte[:200],

                        "nb_corrections": r.get("nb_corrections", 0),

                        "langue": langue,

                        "auto": auto,

                    })



                return self._json(200, r)



            if path == "/api/config/save":

                data = self._body_json()

                for k in ("languagetool_url", "langue_defaut",

                          "debounce_ms", "min_chars", "afficher_terminal"):

